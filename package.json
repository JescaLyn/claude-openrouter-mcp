{
  "name": "openrouter-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing OpenRouter models as named tools for Claude Code. Free models for routine work; paid options gated behind explicit per-call user approval.",
  "type": "module",
  "bin": {
    "openrouter-mcp": "./dist/server.js"
  },
  "main": "./dist/server.js",
  "files": [
    "dist",
    "src/models.snapshot.json",
    ".claude-plugin",
    ".mcp.json",
    "README.md",
    "CLAUDE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "probe:models": "tsx scripts/probe-models.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openrouter",
    "claude-code",
    "anthropic",
    "ai",
    "llm-delegation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JescaLyn/openrouter-mcp.git"
  }
}
